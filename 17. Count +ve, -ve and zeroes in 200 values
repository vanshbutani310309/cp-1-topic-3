#include <stdio.h>

int main() {
    int i;
    float val;
    int pos = 0, neg = 0, zero = 0;
    printf("Enter 200 values:\n");
    for (i = 1; i <= 200; i++) {
        scanf("%f", &val);
        if (val > 0) pos++;
        else if (val < 0) neg++;
        else zero++;
    }
    printf("Positive = %d\nNegative = %d\nZeroes = %d\n", pos, neg, zero);
    return 0;
}
