#include <stdio.h>

int main() {
    int i, boys = 0, girls = 0;
    char sex;
    printf("Enter sex code ('M' for Male, 'F' for Female) for 50 students:\n");
    for (i = 1; i <= 50; i++) {
        printf("Student %d: ", i);
        scanf(" %c", &sex);
        if (sex == 'M' || sex == 'm') boys++;
        else if (sex == 'F' || sex == 'f') girls++;
    }
    printf("Total Boys = %d\nTotal Girls = %d\n", boys, girls);
    return 0;
}
